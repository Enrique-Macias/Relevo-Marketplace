# .easignore — EXISTE, EAS deja de leer .gitignore (rf17-plan-admin.md §1, C8).
# Por eso empieza con una COPIA de .gitignore más el panel de admin, y al final
# lleva lo que el build de la app móvil no necesita (PUSH-4D0).
# Si cambias .gitignore, cambia esto también: si no, el build de EAS sube lo
# que git ignora (.env.local incluido).

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Panel de admin (RF-17): no es parte de la app móvil.
admin/
admin/node_modules/
/admin/

# PUSH-4D0: mínimo contenido en el upload de EAS. El build (CNG) solo necesita
# src/, assets/, app.json, eas.json, package.json, package-lock.json y
# tsconfig.json (Metro resuelve el alias "@/*" desde ahí). Nada de lo de abajo
# lo importa src/, lo lee app.json ni lo corre un script de npm en el build.
/.git
/docs/
/design/
/supabase/
/scripts/
/.claude/
/.agents/
/.codex
/.vscode/
/.wrangler/
/.mcp.json
/CLAUDE.md
/AGENTS.md
/README.md
/skills-lock.json
/eslint.config.js
/.env.example