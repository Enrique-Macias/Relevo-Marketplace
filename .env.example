# Plantilla de variables de entorno. Copia a `.env.local` y rellena los valores.
#
#   cp .env.example .env.local
#
# El prefijo EXPO_PUBLIC_ es obligatorio: sin él, Metro no inyecta la variable
# en el bundle del cliente. Estas dos son públicas por diseño (la key
# publishable está pensada para vivir en el cliente, protegida por RLS) —
# aun así viven fuera de git para poder rotarlas sin tocar el historial.
#
# Ambos valores están en: Dashboard → Project Settings → API Keys.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
